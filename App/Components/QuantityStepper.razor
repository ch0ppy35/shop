<span class="stepper">
    <button type="button" aria-label="Decrease quantity of @ItemName" disabled="@(Value <= Min || Disabled)"
            @onclick="() => Change(Value - 1)">
        <Icon Name="minus"/>
    </button>
    <output class="num" aria-live="polite" aria-label="Quantity">@Value</output>
    <button type="button" aria-label="Increase quantity of @ItemName" disabled="@(Value >= Max || Disabled)"
            @onclick="() => Change(Value + 1)">
        <Icon Name="plus"/>
    </button>
</span>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public int Min { get; set; } = 1;
    [Parameter] public int Max { get; set; } = int.MaxValue;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string ItemName { get; set; } = "item";

    private async Task Change(int value)
    {
        value = Math.Clamp(value, Min, Max);
        if (value != Value)
        {
            await ValueChanged.InvokeAsync(value);
        }
    }
}
