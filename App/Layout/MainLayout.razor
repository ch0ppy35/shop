@inherits LayoutComponentBase

<div class="shell">
    <header class="masthead">
        <div class="masthead-inner">
            <a href="" class="wordmark">NATS Shop</a>
            <NavMenu/>
            <LatencyReadout/>
        </div>
    </header>

    <main class="page">
        <ErrorBoundary>
            @Body
        </ErrorBoundary>
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <span>A demo storefront running on .NET 10 services connected by NATS.</span>
            <SessionInfo/>
        </div>
    </footer>
</div>

<Toaster/>
<ConfirmHost/>
