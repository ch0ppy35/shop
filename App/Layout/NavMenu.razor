@implements IDisposable
@inject CartState CartState

<nav class="nav" aria-label="Main">
    <NavLink href="products">Products</NavLink>
    <NavLink href="cart">
        Cart
        @if (CartState.ItemCount > 0)
        {
            <span class="cart-count num" aria-label="@CartState.ItemCount items">@CartState.ItemCount</span>
        }
    </NavLink>
    <NavLink href="admin/products">Admin</NavLink>
    <NavLink href="about">About</NavLink>
</nav>

@code {
    protected override async Task OnInitializedAsync()
    {
        CartState.Changed += OnCartChanged;
        await CartState.RefreshAsync();
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CartState.Changed -= OnCartChanged;
    }
}
