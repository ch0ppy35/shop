@page "/products/{id}"
@inject ProductService ProductService
@inject CartState CartState
@inject ToastService ToastService

<PageTitle>@(_product?.Name ?? "Product") | NATS Shop</PageTitle>

<a href="products" class="back"><Icon Name="back"/> All products</a>

@if (_loading)
{
    <div class="detail" aria-busy="true">
        <div class="plate is-skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    </div>
}
else if (_product == null)
{
    <div class="empty">
        <h1 class="title">Product not found</h1>
        <p>There's no product with this ID. It may have been deleted from Admin.</p>
        <a href="products" class="btn btn-signal">Browse products</a>
    </div>
}
else
{
    <div class="detail">
        <div>
            <p class="detail-sku spec">@_product.Sku</p>
            <h1 class="detail-name">@_product.Name</h1>
            <p class="detail-desc">@_product.Description</p>
        </div>

        <aside class="buy" aria-label="Purchase">
            <div class="buy-price">$@_product.Price.ToString("F2")</div>
            <StockGauge Quantity="_product.QuantityInStock" ReorderThreshold="_product.ReorderThreshold"/>

            @if (_product.QuantityInStock > 0)
            {
                <div class="buy-row">
                    <QuantityStepper @bind-Value="_quantity" Max="_product.QuantityInStock" ItemName="@_product.Name"/>
                    <button type="button" class="btn btn-signal btn-large" disabled="@_adding" @onclick="AddToCart">
                        <Icon Name="cart"/> Add to cart
                    </button>
                </div>
            }

            <dl class="specs">
                <dt>Ships from</dt>
                <dd>@_product.Location</dd>
                <dt>In stock</dt>
                <dd>@_product.QuantityInStock</dd>
                <dt>Reorder point</dt>
                <dd>@_product.ReorderThreshold</dd>
            </dl>
        </aside>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private Product? _product;
    private bool _loading = true;
    private bool _adding;
    private int _quantity = 1;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _quantity = 1;
        _product = await ProductService.GetProductAsync(Id);
        _loading = false;
    }

    private async Task AddToCart()
    {
        if (_product?.Id == null)
        {
            return;
        }

        _adding = true;
        if (await CartState.AddAsync(_product.Id, _quantity))
        {
            ToastService.ShowSuccess(_quantity == 1
                ? $"Added {_product.Name} to your cart."
                : $"Added {_quantity} × {_product.Name} to your cart.");
            _quantity = 1;
        }
        else
        {
            ToastService.ShowError($"Couldn't add {_product.Name} to your cart. Check that the cart service is running and try again.");
        }

        _adding = false;
    }
}
