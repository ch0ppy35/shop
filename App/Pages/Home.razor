@page "/"
@inject ProductService ProductService
@inject CartState CartState
@inject ToastService ToastService

<PageTitle>NATS Shop</PageTitle>

<section class="hero">
    <div>
        <h1 class="hero-title">Desk hardware, served fast.</h1>
        <p class="hero-copy">
            Keyboards, mice, monitors and the cables between them. Every request goes through a gateway and over
            NATS to small .NET services, and the request log shows how long each one took.
        </p>
        <div class="hero-actions">
            <a href="products" class="btn btn-signal btn-large">Browse products</a>
            <a href="about" class="btn btn-large">How it's built</a>
        </div>
    </div>

    <div class="wire-panel">
        <header>Live requests from this browser, newest first</header>
        <RequestLog Limit="8"/>
    </div>
</section>

<section aria-labelledby="featured-heading">
    <div class="section-head">
        <h2 id="featured-heading">From the catalog</h2>
        <a href="products" class="btn btn-text">See all products</a>
    </div>

    <div class="plates">
        @if (_featured == null)
        {
            @for (var i = 0; i < FeaturedCount; i++)
            {
                <div class="plate is-skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            }
        }
        else
        {
            @foreach (var product in _featured)
            {
                <ProductPlate Product="product" OnAdd="AddToCart" @key="product.Id"/>
            }
        }
    </div>
</section>

@code {
    private const int FeaturedCount = 4;
    private List<Product>? _featured;

    protected override async Task OnInitializedAsync()
    {
        var page = await ProductService.GetProductsAsync(1, FeaturedCount);
        _featured = page.Items;
    }

    private async Task AddToCart(Product product)
    {
        if (await CartState.AddAsync(product.Id!))
        {
            ToastService.ShowSuccess($"Added {product.Name} to your cart.");
        }
        else
        {
            ToastService.ShowError($"Couldn't add {product.Name} to your cart. Check that the cart service is running and try again.");
        }
    }
}
