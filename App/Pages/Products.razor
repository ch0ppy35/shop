@page "/products"
@inject ProductService ProductService
@inject CartState CartState
@inject ToastService ToastService

<PageTitle>Products | NATS Shop</PageTitle>

<div class="page-head">
    <div>
        <h1 class="title">Products</h1>
        @if (_products is { TotalCount: > 0 })
        {
            <p class="lede num">@_products.TotalCount items across @(_products.TotalPages) @(_products.TotalPages == 1 ? "page" : "pages")</p>
        }
    </div>
</div>

@if (_products == null)
{
    <div class="plates" aria-busy="true">
        @for (var i = 0; i < PageSize; i++)
        {
            <div class="plate is-skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        }
    </div>
}
else if (_products.Items.Count == 0)
{
    <div class="empty">
        <h2>No products to show</h2>
        <p>The catalog is empty, or the products service didn't answer. Add a product from Admin, or check that the gateway is running.</p>
        <a href="admin/products" class="btn btn-signal">Add a product</a>
    </div>
}
else
{
    <div class="plates">
        @foreach (var product in _products.Items)
        {
            <ProductPlate Product="product" OnAdd="AddToCart" @key="product.Id"/>
        }
    </div>

    <Pager BasePath="products" PageNumber="_products.PageNumber" TotalPages="_products.TotalPages"/>
}

@code {
    private const int PageSize = 12;
    private PaginatedList<Product>? _products;

    [SupplyParameterFromQuery] public int? Page { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var page = Math.Max(Page ?? 1, 1);
        if (_products?.PageNumber == page)
        {
            return;
        }

        _products = await ProductService.GetProductsAsync(page, PageSize);
    }

    private async Task AddToCart(Product product)
    {
        if (await CartState.AddAsync(product.Id!))
        {
            ToastService.ShowSuccess($"Added {product.Name} to your cart.");
        }
        else
        {
            ToastService.ShowError($"Couldn't add {product.Name} to your cart. Check that the cart service is running and try again.");
        }
    }
}
