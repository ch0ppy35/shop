@page "/cart"
@inject IRecommendationService RecommendationService
@inject CartState CartState
@inject ToastService ToastService
@inject IConfirmService ConfirmService
@implements IDisposable

<PageTitle>Cart | NATS Shop</PageTitle>

<div class="page-head">
    <h1 class="title">Cart</h1>
</div>

@if (_loading)
{
    <p class="lede" aria-busy="true">Loading your cart…</p>
}
else if (Current.IsEmpty)
{
    <div class="empty">
        <h2>Your cart is empty</h2>
        <p>Items you add from the catalog show up here, and stay put for this browser session.</p>
        <a href="products" class="btn btn-signal">Browse products</a>
    </div>
}
else
{
    <div class="cart">
        <section aria-label="Items in your cart">
            <ul class="lines">
                @foreach (var item in Current.Items)
                {
                    <li class="line" @key="item.ProductId">
                        <div>
                            <a class="line-name" href="@($"products/{item.ProductId}")">@item.Name</a>
                            <div class="line-unit num">$@item.Price.ToString("F2") each</div>
                        </div>
                        <QuantityStepper Value="item.Quantity" ItemName="@item.Name" 
                                         ValueChanged="q => UpdateQuantity(item, q)"/>
                        <div class="line-total">$@item.TotalPrice.ToString("F2")</div>
                        <button type="button" class="icon-btn is-danger" aria-label="Remove @item.Name"
                                @onclick="() => RemoveItem(item)">
                            <Icon Name="trash"/>
                        </button>
                    </li>
                }
            </ul>
            <div class="lines-foot">
                <a href="products" class="btn btn-text"><Icon Name="back"/> Keep shopping</a>
                <button type="button" class="btn btn-text btn-danger" @onclick="ClearCart">Empty cart</button>
            </div>
        </section>

        <aside class="summary" aria-label="Order summary">
            <div class="summary-total">
                <span class="num">@Current.ItemCount @(Current.ItemCount == 1 ? "item" : "items")</span>
                <strong>$@Current.TotalPrice.ToString("F2")</strong>
            </div>
            <button type="button" class="btn btn-signal btn-large" disabled>Check out</button>
            <p class="note">Checkout isn't part of this demo. Carts are kept in Valkey for 15 minutes after your last change.</p>
        </aside>
    </div>

    <section class="recs" aria-labelledby="recs-heading">
        <div class="section-head">
            <h2 id="recs-heading">Recommended for this cart</h2>
        </div>

        @if (_loadingRecommendations)
        {
            <div class="plates" aria-busy="true">
                @for (var i = 0; i < RecommendationCount; i++)
                {
                    <div class="plate is-skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                }
            </div>
        }
        else if (_recommendations.Count == 0)
        {
            <p class="lede">No recommendations for these items yet.</p>
        }
        else
        {
            <div class="plates">
                @foreach (var product in _recommendations)
                {
                    <ProductPlate Product="product" OnAdd="AddToCart" @key="product.Id"/>
                }
            </div>
        }
    </section>
}

@code {
    private const int RecommendationCount = 4;

    private List<Product> _recommendations = new();
    private bool _loading = true;
    private bool _loadingRecommendations = true;

    private ShoppingCart Current => CartState.Cart;

    protected override async Task OnInitializedAsync()
    {
        CartState.Changed += OnCartChanged;
        await CartState.EnsureLoadedAsync();
        _loading = false;
        await LoadRecommendationsAsync();
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CartState.Changed -= OnCartChanged;
    }

    private async Task LoadRecommendationsAsync()
    {
        _loadingRecommendations = true;
        var productIds = Current.Items.Where(i => !string.IsNullOrEmpty(i.ProductId)).Select(i => i.ProductId!).ToList();
        _recommendations = productIds.Count == 0
            ? new List<Product>()
            : await RecommendationService.GetRecommendationsAsync(productIds, RecommendationCount);
        _loadingRecommendations = false;
    }

    private async Task UpdateQuantity(CartItem item, int quantity)
    {
        if (string.IsNullOrEmpty(item.ProductId) || quantity < 1)
        {
            return;
        }

        if (!await CartState.SetQuantityAsync(item.ProductId, quantity))
        {
            ToastService.ShowError($"Couldn't change the quantity of {item.Name}. Try again.");
        }
    }

    private async Task RemoveItem(CartItem item)
    {
        if (string.IsNullOrEmpty(item.ProductId))
        {
            return;
        }

        if (await CartState.RemoveAsync(item.ProductId))
        {
            ToastService.ShowInfo($"Removed {item.Name} from your cart.");
            await LoadRecommendationsAsync();
        }
        else
        {
            ToastService.ShowError($"Couldn't remove {item.Name}. Try again.");
        }
    }

    private async Task ClearCart()
    {
        var confirmed = await ConfirmService.ShowConfirmation(
            $"This removes all {Current.ItemCount} items from your cart.",
            "Empty your cart?",
            "Danger",
            "Empty cart");

        if (!confirmed)
        {
            return;
        }

        if (await CartState.ClearAsync())
        {
            ToastService.ShowInfo("Emptied your cart.");
        }
        else
        {
            ToastService.ShowError("Couldn't empty your cart. Try again.");
        }
    }

    private async Task AddToCart(Product product)
    {
        if (await CartState.AddAsync(product))
        {
            ToastService.ShowSuccess($"Added {product.Name} to your cart.");
            await LoadRecommendationsAsync();
        }
        else
        {
            ToastService.ShowError($"Couldn't add {product.Name} to your cart. Check that the cart service is running and try again.");
        }
    }
}
