@page "/admin/products"
@inject ProductService ProductService
@inject ToastService ToastService
@inject IConfirmService ConfirmService

<PageTitle>Admin | NATS Shop</PageTitle>

<div class="page-head">
    <div>
        <h1 class="title">Catalog</h1>
        <p class="lede">Add, edit and remove products. Changes go to the products service and show up in the shop right away.</p>
    </div>
    <button type="button" class="btn btn-signal" @onclick="() => OpenEditor(null)">
        <Icon Name="plus"/> Add product
    </button>
</div>

@if (_products == null)
{
    <p class="lede" aria-busy="true">Loading the catalog…</p>
}
else if (_products.Items.Count == 0)
{
    <div class="empty">
        <h2>The catalog is empty</h2>
        <p>Add your first product and it will appear on the Products page.</p>
        <button type="button" class="btn btn-signal" @onclick="() => OpenEditor(null)">Add product</button>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">SKU</th>
                <th scope="col">Warehouse</th>
                <th scope="col" class="is-num">Price</th>
                <th scope="col">Stock</th>
                <th scope="col" class="is-actions"><span class="visually-hidden">Actions</span></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var product in _products.Items)
            {
                <tr @key="product.Id">
                    <td class="is-name"><a href="@($"products/{product.Id}")">@product.Name</a></td>
                    <td class="spec">@product.Sku</td>
                    <td>@product.Location</td>
                    <td class="is-num">$@product.Price.ToString("F2")</td>
                    <td><StockGauge Quantity="product.QuantityInStock" ReorderThreshold="product.ReorderThreshold"/></td>
                    <td class="is-actions">
                        <button type="button" class="icon-btn" aria-label="Edit @product.Name"
                                @onclick="() => OpenEditor(product)">
                            <Icon Name="edit"/>
                        </button>
                        <button type="button" class="icon-btn is-danger" aria-label="Delete @product.Name"
                                @onclick="() => ConfirmDelete(product)">
                            <Icon Name="trash"/>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <Pager BasePath="admin/products" PageNumber="_products.PageNumber" TotalPages="_products.TotalPages"/>
}

<Modal Open="_editing != null" Title="@(_editing?.Id == null ? "Add product" : "Edit product")"
       OnClose="CloseEditor">
    @if (_editing != null)
    {
        <EditForm Model="_editing" OnValidSubmit="SaveProduct" FormName="product-editor">
            <DataAnnotationsValidator/>
            <div class="modal-body form-grid">
                <div class="field is-wide">
                    <label for="p-name">Name</label>
                    <InputText id="p-name" @bind-Value="_editing.Name" autocomplete="off"/>
                    <ValidationMessage For="() => _editing.Name"/>
                </div>
                <div class="field is-wide">
                    <label for="p-desc">Description</label>
                    <InputTextArea id="p-desc" @bind-Value="_editing.Description" rows="3"/>
                </div>
                <div class="field">
                    <label for="p-price">Price ($)</label>
                    <InputNumber id="p-price" @bind-Value="_editing.Price" step="0.01" min="0"/>
                    <ValidationMessage For="() => _editing.Price"/>
                </div>
                <div class="field">
                    <label for="p-sku">SKU</label>
                    <InputText id="p-sku" @bind-Value="_editing.Sku" autocomplete="off"/>
                </div>
                <div class="field">
                    <label for="p-stock">In stock</label>
                    <InputNumber id="p-stock" @bind-Value="_editing.QuantityInStock" min="0"/>
                    <ValidationMessage For="() => _editing.QuantityInStock"/>
                </div>
                <div class="field">
                    <label for="p-reorder">Reorder point</label>
                    <InputNumber id="p-reorder" @bind-Value="_editing.ReorderThreshold" min="0"/>
                    <ValidationMessage For="() => _editing.ReorderThreshold"/>
                </div>
                <div class="field is-wide">
                    <label for="p-location">Warehouse</label>
                    <InputText id="p-location" @bind-Value="_editing.Location"/>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn" @onclick="CloseEditor">Cancel</button>
                <button type="submit" class="btn btn-signal" disabled="@_saving">
                    @(_editing.Id == null ? "Add product" : "Save changes")
                </button>
            </div>
        </EditForm>
    }
</Modal>

@code {
    private const int PageSize = 10;
    private PaginatedList<Product>? _products;
    private Product? _editing;
    private bool _saving;

    [SupplyParameterFromQuery] public int? Page { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var page = Math.Max(Page ?? 1, 1);
        if (_products?.PageNumber != page)
        {
            await LoadProductsAsync(page);
        }
    }

    private async Task LoadProductsAsync(int page)
    {
        _products = await ProductService.GetProductsAsync(page, PageSize);
    }

    private void OpenEditor(Product? product)
    {
        // Edit a copy so cancelling leaves the table untouched
        _editing = product == null
            ? new Product()
            : new Product
            {
                Id = product.Id,
                Name = product.Name,
                Description = product.Description,
                Price = product.Price,
                Sku = product.Sku,
                Location = product.Location,
                QuantityInStock = product.QuantityInStock,
                ReorderThreshold = product.ReorderThreshold
            };
    }

    private void CloseEditor()
    {
        _editing = null;
    }

    private async Task SaveProduct()
    {
        if (_editing == null)
        {
            return;
        }

        _saving = true;
        var product = _editing;
        var isNew = string.IsNullOrEmpty(product.Id);

        var saved = isNew
            ? await ProductService.CreateProductAsync(product) != null
            : await ProductService.UpdateProductAsync(product);

        _saving = false;

        if (!saved)
        {
            ToastService.ShowError(isNew
                ? "Couldn't add the product. Check that the products service is running and try again."
                : "Couldn't save your changes. Check that the products service is running and try again.");
            return;
        }

        ToastService.ShowSuccess(isNew ? $"Added {product.Name}." : $"Saved changes to {product.Name}.");
        CloseEditor();
        await LoadProductsAsync(_products?.PageNumber ?? 1);
    }

    private async Task ConfirmDelete(Product product)
    {
        var confirmed = await ConfirmService.ShowConfirmation(
            $"{product.Name} will be removed from the catalog. This can't be undone.",
            "Delete this product?",
            "Danger",
            "Delete product");

        if (!confirmed)
        {
            return;
        }

        if (await ProductService.DeleteProductAsync(product.Id!))
        {
            ToastService.ShowSuccess($"Deleted {product.Name}.");
        }
        else
        {
            ToastService.ShowError($"Couldn't delete {product.Name}. Try again.");
        }

        await LoadProductsAsync(_products?.PageNumber ?? 1);
    }
}
